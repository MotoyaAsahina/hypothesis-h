# Environment for running the production image locally with `make docker-run`
# (bin/make_docker_run), against the services started by `make services`.
# `.devdata.env` is loaded after this file and overrides it.
#
# Local use only, with dev-only values: not for real deployments. Per-machine
# values (CLIENT_OAUTH_ID etc.) belong in `.devdata.env`, which is not committed.

APP_URL=http://localhost:5000
AUTHORITY=localhost

# Services from docker-compose.yml (reached by their compose service names).
DATABASE_URL=postgresql://postgres@postgres/postgres
ELASTICSEARCH_URL=http://elasticsearch:9200
BROKER_URL=amqp://guest:guest@rabbit:5672//

# The client container from client/Dockerfile, run with e.g.
#   docker run -d -p 8088:8080 -e H_URL=http://localhost:5000 \
#     -e CLIENT_PUBLIC_URL=http://localhost:8088 hypothesis-client
# `make dev` does not use this: it falls back to h.client_url in
# conf/development.ini (the client dev server on port 3001).
CLIENT_URL=http://localhost:8088/hypothesis

# The image serves the WebSocket through its nginx on port 5000 (/ws).
# (`make dev` runs it separately on port 5001.)
WEBSOCKET_URL=ws://localhost:5000/ws

# Secrets. Dev-only values, the same as tox.ini where one exists.
SECRET_KEY=notasecret
JWT_SIGNING_KEY=dev_jwt_signing_key
H_API_AUTH_COOKIE_SECRET_KEY=dev_h_api_auth_cookie_secret_key
H_API_AUTH_COOKIE_SALT=dev_h_api_auth_cookie_salt

# ORCID has no built-in defaults (Google and Facebook do). Needed by
# /account/settings even though social login is disabled. The client IDs and
# secrets are dummies in .devdata.env.
ORCID_HOST=https://sandbox.orcid.org
OIDC_AUTHORIZATIONURL_ORCID=https://sandbox.orcid.org/oauth/authorize
OIDC_TOKENURL_ORCID=https://sandbox.orcid.org/oauth/token
OIDC_KEYSETURL_ORCID=https://sandbox.orcid.org/oauth/jwks

# Processes started by conf/supervisord.conf. All of them must be defined.
ENABLE_NGINX=true
ENABLE_WEB=true
ENABLE_WORKER=true
ENABLE_WEBSOCKET_MONOLITHIC=true
ENABLE_WEBSOCKET=false
WEB_NUM_WORKERS=2
WEBSOCKET_NUM_WORKERS=2

NEW_RELIC_APP_NAME=h (dev)
